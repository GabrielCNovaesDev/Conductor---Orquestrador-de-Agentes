# LLMs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Banco de dados
DATABASE_URL=postgresql://multiagent:multiagent@postgres:5432/multiagent

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Jira (por workspace - armazenado no banco, nao aqui)
# GitHub (por workspace - armazenado no banco, nao aqui)

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
VITE_API_URL=http://localhost:3000

# Limites
DEFAULT_TASK_TIMEOUT_MS=60000
DEFAULT_MAX_COST_PER_TASK_USD=0.50
